DB_NAME=streamhub
DB_USER=streamhub
DB_PASSWORD=streamhub
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=admin
# Segredo usado para cifrar credenciais das integrações e assinar tokens de reprodução. TROQUE em produção.
APP_SECRET=troque-este-segredo

# Pasta do host montada em /media em todos os contêineres (Windows: C:/Midia).
MEDIA_ROOT=./media
# Disco extra (HD externo) disponível em /hd1 para todos os serviços. Monte o HD antes de subir o Docker.
# Exemplo: EXTRA_STORAGE=/run/media/usuario/MEUHD   (padrão: repete MEDIA_ROOT)
EXTRA_STORAGE=./media
# Pasta onde o sistema monta discos removíveis; tudo que for montado ali aparece em Armazenamento > Adicionar disco.
# Arch/Fedora: /run/media/SEU_USUARIO   Ubuntu/Debian: /media/SEU_USUARIO
DISKS_DIR=./disks
# Dados de configuração dos serviços (Prowlarr, Sonarr, Radarr, qBittorrent, Jellyfin)
DATA_ROOT=./data
# UID/GID que executam os contêineres (Linux: `id -u` / `id -g`)
PUID=1000
PGID=1000

# Chave do TMDB (v3 api_key ou token de leitura v4). Obtenha em themoviedb.org/settings/api
TMDB_API_KEY=
# Credenciais do qBittorrent (o compose já pré-configura admin/adminadmin)
QBIT_USER=admin
QBIT_PASSWORD=adminadmin
# Chave de API do Jellyfin (Painel > Chaves de API). Opcional.
JELLYFIN_API_KEY=
JELLYFIN_PUBLIC_URL=http://localhost:8096
# true = após concluir, pede ao Sonarr/Radarr para importar (copiando) o arquivo
ARR_IMPORT_ON_COMPLETE=false
